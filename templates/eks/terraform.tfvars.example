# Minimal dev cluster. Copy to terraform.tfvars and replace the placeholders.
cluster_name       = "score-dev-eks"
aws_account_id     = "123456789012"
region             = "us-east-1"
environment        = "dev"
plane              = "resource"
kubernetes_version = "1.34"

# Networks allowed to reach the Kubernetes API, e.g. the office or VM egress IP.
api_allowed_cidrs = ["203.0.113.10/32"]

vpc_cidr             = "10.90.0.0/16"
azs                  = ["us-east-1a", "us-east-1b"]
private_subnet_cidrs = ["10.90.0.0/20", "10.90.16.0/20"]
public_subnet_cidrs  = ["10.90.240.0/24", "10.90.241.0/24"]

node_instance_types = ["t3.small"]
node_min_size       = 1
node_max_size       = 2
node_desired_size   = 2

tags = {
  owner = "platform-team"
}
